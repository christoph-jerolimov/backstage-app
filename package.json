{
  "name": "backstage-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "start": "npm run start --workspace packages/app",
    "android": "npm run android --workspace packages/app",
    "ios": "npm run ios --workspace packages/app",
    "web": "npm run web --workspace packages/app",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "knip-reports": "backstage-repo-tools knip-reports",
    "knip-reports:check": "backstage-repo-tools knip-reports --ci",
    "test": "jest"
  },
  "devDependencies": {
    "@backstage/repo-tools": "^0.19.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "knip": "^5.88.1",
    "typescript": "~6.0.3"
  }
}
