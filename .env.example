# Copy to .env (or .env.local) inside packages/app, or export in your shell.
# Seeds the first Backstage instance on a fresh install (manage instances in Account afterwards).
# Leave unset to start in demo mode.
EXPO_PUBLIC_BACKSTAGE_URL=https://backstage.example.com
# Optional static bearer token for the Backstage backend (external access token).
EXPO_PUBLIC_BACKSTAGE_TOKEN=

# Analytics. Once a Backstage instance is configured, the app reports each page the user
# opens to that instance — the route only, never the query string, so nothing a user typed
# is sent. Set to false to send nothing at all.
EXPO_PUBLIC_BACKSTAGE_ANALYTICS=true
# Backend path a batch of events is POSTed to. Backstage core does not standardize one, so
# override this if your deployment serves it elsewhere (for example through the proxy).
EXPO_PUBLIC_BACKSTAGE_ANALYTICS_PATH=/api/analytics/v1/events
