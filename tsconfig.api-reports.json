// Declaration-only compile that feeds `backstage-repo-tools api-reports`.
// API Extractor analyses .d.ts files and expects them under
// dist-types/<workspace>/src/index.d.ts; nothing else in this repo emits any.
{
  "extends": "./packages/app/tsconfig.json",
  "compilerOptions": {
    // expo/tsconfig.base sets noEmit; declarations are the whole point here.
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "outDir": "dist-types",
    "rootDir": ".",
    // expo/types declares the CSS module shims that packages/core/src/theme.ts
    // relies on for its `./global.css` side-effect import. Tests are excluded
    // below, so jest types are not needed.
    "types": ["expo/types"]
  },
  // packages/app is the application, not a library, and has no API report.
  "include": [
    "packages/core/src/**/*.ts",
    "packages/core/src/**/*.tsx",
    "packages/errors/src/**/*.ts",
    "packages/errors/src/**/*.tsx",
    "plugins/*/src/**/*.ts",
    "plugins/*/src/**/*.tsx"
  ],
  "exclude": ["**/__tests__/**"]
}
